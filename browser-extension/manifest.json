{
  "manifest_version": 3,
  "name": "Anime Rich Presence",
  "description": "Show what anime you're watching on Discord",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://miruro.tv/*",
    "https://miruro.to/*",
    "https://www.miruro.to/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://miruro.tv/*",
        "https://miruro.to/*",
        "https://www.miruro.to/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
