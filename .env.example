# Discord Application ID from https://discord.com/developers/applications
# (Optional: uses the built-in default if left unset)
DISCORD_CLIENT_ID=your_discord_application_id_here

# Discord Rich Presence display style
# Activity type: watching | playing | listening | competing
DISCORD_ACTIVITY_TYPE=watching
# Member list / status display: details (shows anime title) | state | name (shows app name)
DISCORD_STATUS_DISPLAY=details

# Local Flask bridge server settings
HOST=localhost
PORT=3000
